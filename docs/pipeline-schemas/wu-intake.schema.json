          "enum": [
            "lower_is_better",
            "higher_is_better",
            "descriptive_only"
          ],
          "title": "Direction",
          "type": "string"
        },
        "comparability_status": {
          "enum": [
            "established",
            "partial",
            "unknown"
          ],
          "title": "Comparability Status",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "involved_factor_ids": {
          "items": {
            "type": "string"
          },
          "title": "Involved Factor Ids",
          "type": "array"
        },
        "isolated_factor_ids": {
          "items": {
            "type": "string"
          },
          "title": "Isolated Factor Ids",
          "type": "array"
        },
        "notes": {
          "title": "Notes",
          "type": "string"
        }
