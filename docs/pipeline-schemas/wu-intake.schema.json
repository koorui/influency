        "name": {
          "enum": [
            "outcome_name",
            "outcome_type",
            "description",
            "problem_solved",
            "participating_units",
            "core_members",
            "related_outputs",
            "key_metrics",
            "baseline",
            "ai_role",
            "claimed_application",
            "support_materials"
          ],
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "status": {
          "enum": [
            "confirmed",
            "partial",
            "missing"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "name",
        "value",
        "status",
        "evidence_ids"
      ],
      "title": "CardField",
      "type": "object"
    },
    "Comparison": {
      "additionalProperties": false,
