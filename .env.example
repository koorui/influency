# Copy to .env and replace all three secrets before starting.
MYSQL_ROOT_PASSWORD=replace-with-random-root-password
MYSQL_PASSWORD=replace-with-random-db-password
SECRET_KEY=replace-with-random-secret-at-least-32-characters
DATABASE_URL=mysql+pymysql://impact:replace-with-random-db-password@127.0.0.1:13307/impact?charset=utf8mb4
STORAGE_DIR=./storage
ALLOWED_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
EVALUATION_ADAPTER=mock
# Upload limits (defaults are 200MB per file, 2GB per batch, 5GB expanded ZIP).
MAX_UPLOAD_MB=200
BATCH_MAX_FILES=200
BATCH_MAX_TOTAL_MB=2048
ARCHIVE_MAX_EXPANDED_MB=5120
# Set EVALUATION_ADAPTER=codex after Codex CLI is installed and authenticated on the worker host.
CODEX_BINARY=
CODEX_MODEL=gpt-6-astra
CODEX_REASONING_EFFORT=medium
CODEX_TIMEOUT_SECONDS=480
CODEX_SEARCH=true
CODEX_MAX_INPUT_CHARS=200000
# v19 uses its own explicitly configured OpenAI-compatible service, not Codex authentication.
V19_API_KEY=
V19_BASE_URL=
V19_MODEL=
V19_TRANSPORT=codex
