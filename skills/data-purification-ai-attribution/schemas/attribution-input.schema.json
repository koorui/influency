{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dca-attribution-input/v1",
  "title": "AI contribution attribution input",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "target",
    "evidence",
    "factors",
    "comparisons",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": "dca-attribution-input/v1"
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source_type",
          "locator",
          "text"
        ]
      }
    },
    "factors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "role_in_attribution": {
            "enum": [
              "baseline",
              "contributor",
              "target"
            ]
          },
          "evaluate_independent_increment": {
            "type": "boolean"
          }
        }
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "baseline",
          "observed",
          "direction",
          "comparability_status",
          "evidence_ids",
          "involved_factor_ids",
          "isolated_factor_ids"
        ],
        "properties": {
          "comparability_status": {
            "enum": [
              "established",
              "partial",
              "unknown"
            ]
          },
          "comparison_kind": {
            "enum": [
              "threshold_check",
              "performance_change",
              "external_benchmark",
              "causal_increment",
              "unspecified"
            ]
          },
          "baseline_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "observed_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "control_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "controlled_conditions": {
            "type": "string"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "evidence_ids"
        ]
      }
    },
    "search_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "statement",
          "reason"
        ],
        "properties": {
          "status": {
            "enum": [
              "conflicts",
              "not_found",
              "needs_expert"
            ]
          }
        }
      }
    }
  }
}
